{
  "name": "mochi",
  "version": "1.0.0",
  "description": "A giant pastel blob co-parented by the whole server. Decentraland SDK7, built for mobile.",
  "scripts": {
    "start": "sdk-commands start",
    "start:mobile": "sdk-commands start --mobile",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "ci": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.0",
    "@dcl/sdk": "latest",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}

# Mochi server — example environment.
#
# Copy to `.env` and edit, or just export these on the host. You do not need any
# of them: every value below is the built-in default, so `npm start` works with
# no setup at all. They exist so a running host can be retuned without a
# rebuild.
#
# THERE ARE NO SECRETS IN THIS FILE, and none anywhere else in this project.
# The server has no credentials of its own — no API keys, no tokens, no
# third-party accounts. Everything here is a tunable. If you ever find something
# that looks like a credential in this repository, please report it (see
# ../.github/SECURITY.md).
#
# `.env` itself is gitignored. Keep it that way.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Bind address. 0.0.0.0 listens on every interface, which is what you want in a
# container; 127.0.0.1 keeps it local.
MOCHI_HOST=0.0.0.0

# Port for both the WebSocket and the /health endpoint — one listener, one port.
MOCHI_PORT=8080

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# The SQLite file, via node:sqlite (Node 22.5+ — nothing to install). Point this
# at a mounted volume in production: the database is the only copy of the
# history, and it cannot be rebuilt. `:memory:` is accepted and is what the
# tests use.
MOCHI_DB_PATH=./data/mochi.db

# ---------------------------------------------------------------------------
# Hunger
# ---------------------------------------------------------------------------
# Hunger is derived from timestamps rather than ticked, so these change the
# curve immediately, with no migration and no background job.

# Hours from a full belly down to the floor. Long on purpose — a creature tended
# by strangers should still be hungry when you come back tomorrow, without
# having visibly starved while you were away.
MOCHI_HUNGER_DECAY_HOURS=36

# The value hunger decays toward and never passes. This is the difference
# between "needy" and "abandoned": an unvisited creature must read as wanting
# company, never as dying, so hunger asymptotes here instead of reaching zero.
# Clamped to the range 0–0.95.
MOCHI_HUNGER_FLOOR=0.15

# How much hunger one feeding restores. Also the growth increment — the blob's
# size is the literal sum of every feeding.
MOCHI_FEED_GAIN=0.2

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
# Per wallet, per rolling minute. These are anti-spam, not scarcity — they are
# set so a person playing normally never meets one.

# Feeds per wallet per minute.
MOCHI_LIMIT_FEED=4

# Chain moves taught per wallet per minute. The lowest limit on purpose: every
# move is permanent and credited to a named teacher.
MOCHI_LIMIT_TEACH=2

# Pets per wallet per minute. The cheapest, most repeatable gesture, so the most
# generous limit.
MOCHI_LIMIT_PET=10

# Guestbook stamps per wallet per minute.
MOCHI_LIMIT_STAMP=2

# ---------------------------------------------------------------------------
# What a client is told on connect
# ---------------------------------------------------------------------------

# How many chain moves ride along in a `state` message. Caps the size of the
# first payload and the length of one performance. Minimum 1.
MOCHI_CHAIN_LIMIT=40

# How far back the carer list reaches, in hours — the window the plaque and the
# ring of memory dancers are drawn from. Minimum 1.
MOCHI_CARER_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Local development fixture only
# ---------------------------------------------------------------------------

# Read by `npm run seed:dev`, never by the server itself. The fixture writes
# obviously-synthetic `DEV_ONLY_` rows to its own throwaway database, and
# refuses to run if this equals MOCHI_DB_PATH (or if NODE_ENV=production).
MOCHI_DEV_DB_PATH=./data/dev.db

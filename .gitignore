# Decentraland SDK7 build output
*.js
bin/
node_modules/

# Server: compiled output and the local SQLite file. The database is state, not
# source — it is created on first run and backed up from the host, never here.
server/dist/
server/data/

# Coverage output. The number belongs in CI and in the README; the generated
# HTML and lcov do not belong in the repository.
coverage/
server/coverage/
*.db
*.db-wal
*.db-shm

# Generated by `npm install` — SDK reference material for AI editors, not our
# source. Regenerates on every install, so it is ignored rather than deleted.
dclcontext/

# Secrets — credentials live in ~/.config, never in the tree
.env
.env.*

# ...except the documented example, which contains only defaults and no secrets
!.env.example

# Judge-facing media: allowlist, not a dumping ground. Only the files the README
# and JUDGE.md actually render belong here. Everything else the project generates
# (logo exports, OG image, video thumbnails) lives in the private assets/ folder
# and is uploaded to submission forms from there — it has no reason to sit in a
# public repo, and stale platform-named files leak the pipeline.
docs/assets/*
!docs/assets/icon-animated.svg
!docs/assets/readme-hero-animated.svg
!docs/assets/world-qr.png

# OS / editor noise
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

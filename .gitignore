# Decentraland SDK7 build output
*.js
bin/
node_modules/

# Generated by `npm install` — SDK reference material for AI editors, not our
# source. Regenerates on every install, so it is ignored rather than deleted.
dclcontext/

# Secrets — credentials live in ~/.config, never in the tree
.env
.env.*

# OS / editor noise
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

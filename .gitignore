# Decentraland SDK7 build output
*.js
bin/
node_modules/

# Server: compiled output and the local SQLite file. The database is state, not
# source — it is created on first run and backed up from the host, never here.
server/dist/
server/data/
*.db
*.db-wal
*.db-shm

# Generated by `npm install` — SDK reference material for AI editors, not our
# source. Regenerates on every install, so it is ignored rather than deleted.
dclcontext/

# Secrets — credentials live in ~/.config, never in the tree
.env
.env.*

# OS / editor noise
.DS_Store
**/.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

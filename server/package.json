{
  "name": "mochi-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative game server for Mochi. Owns pet state, the dance chain and the carer log.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:dev": "npm run build && node dist/scripts/seed-dev.js",
    "bench": "npm run build && node dist/scripts/bench.js",
    "retention": "npm run build && node dist/scripts/returning-carers.js",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
